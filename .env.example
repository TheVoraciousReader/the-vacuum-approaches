# Copy to .env.production (or export) before `pnpm build`.
# Absolute origin, no trailing slash. Must match the public host (www vs apex).
# Production build throws if this is empty.
VITE_SITE_URL=

SITE_TITLE=The Vacuum Approaches
SITE_DESCRIPTION=You are the dog. The vacuum lives here too. Wander a tiny house, pick a verb, and chase an ending — or get eaten.
